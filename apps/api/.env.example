# App
APP_NAME=attendance-management-system
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Lokal via docker compose:
DATABASE_URL="postgresql://postgres:secret@db:5432/attendance?schema=public"
DIRECT_URL="postgresql://postgres:secret@db:5432/attendance?schema=public"
# Supabase: DATABASE_URL pakai transaction pooler (6543), DIRECT_URL pakai
# session mode (5432) untuk prisma migrate.
# DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Attendance
# Batas jam sejak check-in sesi masih boleh di-check-out sendiri oleh user.
MAX_OPEN_SESSION_HOURS=18

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Set true (atau jumlah hop) kalau server di belakang proxy/ngrok.
TRUST_PROXY=false

# Password reset
RESET_PASSWORD_TOKEN_EXPIRES=3600
RESET_URL_BASE=http://localhost:5174/auth/reset-password

# Mail (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Absensi <no-reply@attendance.local>"

# Supabase Storage
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FACES=faces
SUPABASE_BUCKET_PROFILE=profiles
SUPABASE_BUCKET_DOCS=permissions

# Face recognition
FACE_POOL_SIZE=2

# CORS: pisah koma, mendukung wildcard (http://localhost:*)
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*

# Assets
URL_ASSETS_ATTENDANCE="http://localhost:3000/images/attendance/"
